# HUB DIGI — template .env prod (copier vers backend/.env sur le VPS, JAMAIS commité).
# Même pattern que DIGI-AGENCY deploy/.env.production.example.
DJANGO_SECRET_KEY=change-me-32-caracteres-minimum-generer-avec-get_random_secret_key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=hub.digicom.ml,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://hub.digicom.ml
CSRF_TRUSTED_ORIGINS=https://hub.digicom.ml

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
CELERY_EAGER=1

# Paiement en ligne : 0 = neutralisé (logique conservée, pas de QR/lien mort), 1 = actif.
# Frontend suit avec VITE_PAIEMENT_ACTIF (ARG Docker, défaut "false").
PAYMENT_ENABLED=0
PAYMENT_URL=https://pay.digicom.ml

# Token partagé site vitrine -> HUB (WEBHOOK-CARRIERE.md) — MÊME valeur que
# HUB_WEBHOOK_TOKEN côté DIGI-AGENCY. Vide = webhook refusé (403).
# URL canonique HUB : https://hub.digicom.ml/api/v1/rh/candidatures/
CAREER_WEBHOOK_TOKEN=change-me-32-caracteres-minimum

# Mails système Django UNIQUEMENT (reset password 24h, erreurs) via SMTP port 465 = SSL.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=admin@digicom.ml
FRONTEND_URL=https://hub.digicom.ml
EMAIL_HOST=digicom.ml
EMAIL_PORT=465
EMAIL_HOST_USER=noreply@digicom.ml
EMAIL_HOST_PASSWORD=change-me-mot-de-passe-smtp
EMAIL_TIMEOUT=15
