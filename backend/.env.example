# Copier vers .env et adapter (ne jamais committer le vrai .env)
DJANGO_SECRET_KEY=change-me-32-caracteres-minimum
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5199,http://127.0.0.1:5199
# Prod hub.digicom.ml (SPEC §15) :
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=hub.digicom.ml,localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=https://hub.digicom.ml
# CSRF_TRUSTED_ORIGINS=https://hub.digicom.ml
CSRF_TRUSTED_ORIGINS=https://hub.digicom.ml
# Paiement en ligne : 0 = neutralisé (logique conservée, pas de QR/lien mort), 1 = actif
PAYMENT_ENABLED=0
# LigdiCash (payin avec redirection) : 0 = API non appelée, 1 = payin activé.
# Les clés ne sortent JAMAIS du backend : jamais dans le frontend, jamais dans git.
LIGDICASH_ENABLED=0
LIGDICASH_API_KEY=change-me-cle-api-ligdicash
LIGDICASH_API_TOKEN=change-me-token-ligdicash
LIGDICASH_BASE_URL=https://app.ligdicash.com
LIGDICASH_STORE_NAME=Digi Com & Technologies
LIGDICASH_STORE_URL=http://localhost:5199
# URL publique de notification : LigdiCash y poste en JSON + form-urlencoded.
# En dev, exposer le backend (tunnel) sinon aucun callback ne remonte.
LIGDICASH_CALLBACK_URL=http://localhost:8000/api/v1/finance/paiements/ligdicash/callback/
# Vérifie que la page de paiement LigdiCash existe avant de rediriger le client
# (LigdiCash sert une 404 sur une facture encore en propagation). 0 = ne plus vérifier.
LIGDICASH_VERIF_PAGE=1
# Fenêtre de reprise d'une tentative en cours (la page LigdiCash expire ~16 min).
LIGDICASH_FENETRE_REPRISE_MINUTES=15
# Prod (à décommenter sur le VPS) :
# LIGDICASH_TIMEOUT=20
# LIGDICASH_STORE_URL=https://hub.digicom.ml
# Base SQLite Django uniquement (db.sqlite3) — pas de PostgreSQL dans ce projet.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Celery sans Redis : tâches en mode eager (synchrone) par défaut, rien à installer.
CELERY_EAGER=1
# Vrai async (optionnel) : CELERY_EAGER=0 + serveur Redis + pip install redis
# CELERY_BROKER_URL=redis://localhost:6379/0
# Token partagé site vitrine -> HUB (WEBHOOK-CARRIERE.md)
CAREER_WEBHOOK_TOKEN=change-me-32-caracteres-minimum
# Mails système : console en dev, SMTP en prod (port 465 = SSL, 587 = TLS)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=admin@digicom.ml
# FRONTEND_URL=https://hub.digicom.ml
# EMAIL_HOST=digicom.ml
# EMAIL_PORT=465
# EMAIL_HOST_USER=noreply@digicom.ml
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_TIMEOUT=15
