# Dev local : API Django + flag paiement en ligne (mettre à true quand LigdiCash est configuré
# côté backend : PAYMENT_ENABLED=1 + LIGDICASH_ENABLED=1 + clés LIGDICASH_*)
VITE_API_URL=http://localhost:8000/api/v1
VITE_PAIEMENT_ACTIF=false
# Prod (au moment du build sur le VPS) :
# VITE_API_URL=https://hub.digicom.ml/api/v1
# VITE_PAIEMENT_ACTIF=true
# Déconnexion auto après inactivité (défauts : 15 min, préavis 2 min).
# Pour tester vite en local : VITE_INACTIVITE_MINUTES=1 + VITE_PREAVIS_MINUTES=1
# VITE_INACTIVITE_MINUTES=15
# VITE_PREAVIS_MINUTES=2
